# FilterKappi Configuration Example
# Copy to .env for local overrides. Do NOT store real secrets in this file.

# Server Settings
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=10s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
MAX_HEADER_BYTES=1048576
MAX_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT=10s
LOG_LEVEL=INFO

# Database Settings (Isolated on internal network; not exposed to host)
DB_HOST=db
DB_PORT=5432
DB_NAME=filterkappi
DB_USER=filterkappi
DB_PASSWORD=your_local_dev_password_here
